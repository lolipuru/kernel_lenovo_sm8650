# Arch
CONFIG_ARCH_KIRBY=y

# Haptics
CONFIG_AWINIC_HAPTIC_HV=m

# HQSYS debug drivers
CONFIG_HQ_SYSFS_SUPPORT=m

# Lcd bias
CONFIG_AW3750X_POWER=m

# Touchscreen
CONFIG_TOUCHSCREEN_NT36XXX_SPI=m

# USB
CONFIG_USB_REDRIVER_PS5169=m
CONFIG_QCOM_FSA4480_SUB_I2C=m

# Lenovo specific
CONFIG_LENOVO_KEYBOARD=m
CONFIG_LENOVO_THERMAL_CONTROL=m
CONFIG_LENOVO_SYS_TEMP=m
CONFIG_LENOVO_BL_BOOSTER=m

# CONFIG_VIDEO_QCOM_VENUS is not set
